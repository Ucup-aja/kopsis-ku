# Salin jadi .env lalu GANTI nilainya. File .env TIDAK di-commit.
#   cp .env.example .env

# Kredensial database — wajib diganti dengan password kuat.
DB_USER=koperasi
DB_PASS=GANTI_DENGAN_PASSWORD_KUAT
DB_ROOT_PASS=GANTI_ROOT_PASSWORD_KUAT

# Prefix URL aplikasi (backend disajikan di /koperasi_siswa/backend).
APP_PREFIX=/koperasi_siswa

# Origin yang boleh mengakses API (CORS). '*' = semua origin.
ALLOWED_ORIGIN=*

# Host port backend di mesin host. URL lokal: http://localhost:8080/koperasi_siswa
BACKEND_PORT=8080

# Token Cloudflare Tunnel bernama (kosongkan untuk tunnel cepat *.trycloudflare.com).
TUNNEL_TOKEN=
