# Salin file ini menjadi .env lalu GANTI nilainya.
#   cp .env.example .env
# File .env TIDAK di-commit (lihat .gitignore) — jangan pernah push isinya.

# Password database untuk container koperasi_db.
# GANTI dengan password kuat minimal 16 karakter.
DB_PASS=GANTI_DENGAN_PASSWORD_KUAT

# Nama database & user (boleh dibiarkan default).
DB_NAME=koperasi_siswa
DB_USER=koperasi

# Hostname yang dipakai Cloudflare Tunnel.
APP_HOST=koperasi.cnp.my.id
